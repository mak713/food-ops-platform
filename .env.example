# Copy the relevant sections of this file into the real, gitignored env files:
#   backend/.env   -- read explicitly by backend/app/core/config.py
#   frontend/.env  -- read automatically by Vite (only VITE_-prefixed keys reach client code)
#   .env           -- read automatically by `docker compose` when run from the repo root
#
# This file is the single documented reference for every variable the system uses.
# Real values are never committed.

# ============================================================
# Docker Compose (root .env) — PostgreSQL container settings
# ============================================================

# Development database (created automatically by the postgres image on first boot)
POSTGRES_USER=foodops
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=foodops_dev

# Test database (created by docker/init-test-db.sh on first boot, alongside POSTGRES_DB)
POSTGRES_TEST_DB=foodops_test

# Host port the Postgres container is published on
POSTGRES_PORT=5432

# ============================================================
# Backend (backend/.env)
# ============================================================

# Full SQLAlchemy connection string for the development database.
DATABASE_URL=postgresql+psycopg://foodops:change-me-locally@localhost:5432/foodops_dev

# Full SQLAlchemy connection string for the DEDICATED test database.
# Must always point at a different database than DATABASE_URL — the test suite
# refuses to run otherwise (see backend/tests/conftest.py).
TEST_DATABASE_URL=postgresql+psycopg://foodops:change-me-locally@localhost:5432/foodops_test

# development | test | production
ENVIRONMENT=development

# Allowed CORS origin for the frontend dev server (only load-bearing when not using
# the Vite dev-server proxy; see frontend/vite.config.ts).
FRONTEND_ORIGIN=http://localhost:5173

# --- Session/auth secrets: not used until Phase 2 (Authentication). ---
# SESSION_SECRET_KEY=

# --- Mail/password-reset config: not used until Phase 2. ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# ============================================================
# Frontend (frontend/.env)
# ============================================================

# Only needed if the Vite dev-server proxy (server.proxy in vite.config.ts) is bypassed.
# VITE_API_BASE_URL=http://localhost:8000
